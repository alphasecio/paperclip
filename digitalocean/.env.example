# Auto-generated by deploy.sh
BETTER_AUTH_SECRET=
PAPERCLIP_AGENT_JWT_SECRET=

# Domain pointing at the droplet, e.g. paperclip.yourdomain.com
# Leave empty for IP-only HTTP (testing only: logins are sent unencrypted)
CADDY_DOMAIN=

# Auto-set by deploy.sh from CADDY_DOMAIN or the droplet IP
PAPERCLIP_PUBLIC_URL=
PAPERCLIP_BIND=127.0.0.1
COMPOSE_PROFILES=

# Optional: external PostgreSQL. Leave unset to use embedded PostgreSQL.
# DATABASE_URL=

# Sign-up closes automatically once the admin account exists.
# Set to false to keep it open (e.g. to invite teammates), true to close it now.
# PAPERCLIP_AUTH_DISABLE_SIGN_UP=

PAPERCLIP_TELEMETRY_DISABLED=1
DO_NOT_TRACK=1

# LLM provider keys: add at least one before running agents
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
